FROM golang:1.24-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /inferbolt-gateway ./cmd/gateway

FROM alpine:3.19
RUN apk --no-cache add ca-certificates curl
COPY --from=builder /inferbolt-gateway /inferbolt-gateway
EXPOSE 8080
ENTRYPOINT ["/inferbolt-gateway"]
